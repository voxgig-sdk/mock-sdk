# Entity: user

main: kit: entity: user: {

  alias: field: {}

  fields: [
    {
      format: "email"
      name: "email"
      req: false
      short: "User email address"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "User ID"
      type: "`$STRING`"
    }
    {
      name: "username"
      req: false
      short: "Username"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "user"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/public/users"
          segments: [
            {
              lit: "public"
            }
            {
              lit: "users"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
