# Entity: coupon

main: kit: entity: coupon: {

  alias: field: {}

  fields: [
    {
      name: "code"
      req: false
      short: "Coupon code"
      type: "`$STRING`"
    }
    {
      name: "discount"
      req: false
      short: "Discount amount or percentage"
      type: "`$NUMBER`"
    }
    {
      name: "id"
      req: false
      short: "Coupon ID"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "coupon"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/public/coupons"
          segments: [
            {
              lit: "public"
            }
            {
              lit: "coupons"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
